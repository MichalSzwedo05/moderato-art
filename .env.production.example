# Copy this file to .env.production on the VPS and replace every placeholder.
ACME_EMAIL=owner@example.com
APP_IMAGE=ghcr.io/michalszwedo05/moderato-art:replace-with-commit-sha
DATABASE_URL=postgresql://moderato:replace-with-a-long-random-password@db:5432/moderato?schema=public
DIRECT_URL=postgresql://moderato:replace-with-a-long-random-password@db:5432/moderato?schema=public
POSTGRES_DB=moderato
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=moderato
SITE_DOMAIN=moderato-art.pl
CONTACT_FORM_ENABLED=false
# Keep test mode disabled except during a short, synthetic-data-only Resend test.
CONTACT_FORM_TEST_ENABLED=false
CONTACT_FORM_TEST_TOKEN=replace-with-a-random-token-of-at-least-32-characters
RESEND_API_KEY=re_replace-with-a-restricted-sending-key
CONTACT_FORM_RECIPIENT=owner@example.com
# App-level CMS login. Do not add Caddy browser Basic Auth.
ADMIN_CMS_ENABLED=false
ADMIN_AUTH_MODE=magic_link
ADMIN_EMAIL=owner@example.com
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_AUTH_URL=https://moderato-art.pl
ADMIN_AUTH_RESEND_FROM=Moderato Art <admin@moderato-art.pl>
ADMIN_AUTH_RESEND_KEY=re_replace-with-a-dedicated-restricted-key
ADMIN_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
