{
  "name": "moderato-art",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "next dev",
    "build": "npm run db:generate && next build --webpack",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate:deploy; fi; npm run build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsc --noEmit",
    "test": "vitest run",
    "test:sms": "SMSAPI_LIVE_TEST=true vitest run lib/smsapi.integration.test.ts",
    "test:related": "vitest related --run",
    "db:generate": "PRISMA_GENERATE=true prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "googleapis": "^182.0.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.30.0",
    "sharp": "0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^18.0.4",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.7",
    "mysql2": "3.22.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.18"
  }
}
