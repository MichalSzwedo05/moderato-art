generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContactSubmissionStatus {
  NEW
  CONTACTED
  ARCHIVED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GalleryPhotoStatus {
  PENDING
  PROCESSING
  ACTIVE
  DELETING
}

enum GalleryPhotoVariant {
  FULL
  THUMBNAIL
}

model ContactSubmission {
  id                       String                  @id @default(cuid())
  parentName               String?                 @db.VarChar(120)
  childName                String?                 @db.VarChar(120)
  birthDate                String?                 @db.VarChar(20)
  preschool                String?                 @db.VarChar(200)
  group                    String?                 @db.VarChar(100)
  address                  String?                 @db.VarChar(300)
  email                    String                  @db.VarChar(254)
  phone                    String?                 @db.VarChar(40)
  lessonType               String?                 @db.VarChar(80)
  childAgeRange            String?                 @db.VarChar(40)
  message                  String                  @db.Text
  paymentAccepted          Boolean                 @default(false)
  imageConsent             String?                 @db.VarChar(30)
  privacyNoticeVersion     String?                 @db.VarChar(40)
  privacyNoticeAcknowledgedAt DateTime?
  status                   ContactSubmissionStatus @default(NEW)
  retentionAnchorAt        DateTime                @default(now())
  deleteAfter              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([deleteAfter])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
}

model Article {
  id            String        @id @default(cuid())
  title         String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(220)
  content       String        @db.Text
  category      String        @db.VarChar(100)
  excerpt       String        @db.VarChar(500)
  imageUrl      String?       @map("coverImageUrl") @db.VarChar(2048)
  status        ArticleStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category, status])
  @@index([status, publishedAt])
}

model GalleryPhoto {
  id                 String            @id @default(cuid())
  altText            String            @db.VarChar(240)
  imageUrl           String?           @db.VarChar(2048)
  thumbnailUrl       String?           @db.VarChar(2048)
  width              Int?
  height             Int?
  mimeType           String?           @db.VarChar(50)
  sizeBytes          Int?
  sortOrder          Int               @default(0)
  status             GalleryPhotoStatus @default(PENDING)
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assets             GalleryPhotoAsset[]
  uploadChunks       GalleryPhotoUploadChunk[]

  @@index([status, sortOrder])
  @@index([status, expiresAt])
}

model GalleryPhotoAsset {
  photoId   String
  variant   GalleryPhotoVariant
  data      Bytes
  sizeBytes Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photo     GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([photoId, variant])
}

model GalleryPhotoUploadChunk {
  photoId    String
  chunkIndex Int
  data       Bytes
  sizeBytes  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  photo      GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([photoId, chunkIndex])
  @@index([photoId, chunkIndex])
}

model AdminMagicLink {
  id            String   @id @default(cuid())
  tokenHash     String   @unique @db.Char(64)
  requesterHash String   @db.Char(64)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

model AdminSession {
  id          String   @id @default(cuid())
  authMode    String   @default("magic_link") @db.VarChar(20)
  credentialVersion String @default("b31f6b9a4489f6b772bcc4ce53579d138bb0c2ad97bfb35074501b989ba150b9") @db.Char(64)
  sessionHash String   @unique @db.Char(64)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

model AdminLoginRateLimit {
  identifierHash String   @id @db.Char(64)
  attempts       Int
  resetAt        DateTime
  updatedAt      DateTime @updatedAt

  @@index([resetAt])
}
