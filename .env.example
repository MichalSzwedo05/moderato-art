POSTGRES_DB=moderato
POSTGRES_PASSWORD=moderato_dev_password
POSTGRES_USER=moderato
DATABASE_URL=postgresql://moderato:moderato_dev_password@localhost:5432/moderato?schema=public
DIRECT_URL=postgresql://moderato:moderato_dev_password@localhost:5432/moderato?schema=public
CONTACT_FORM_ENABLED=false
# Leave disabled unless all ADMIN_* values are set. ADMIN_AUTH_URL must be the HTTPS public origin.
ADMIN_CMS_ENABLED=false
ADMIN_EMAIL=owner@example.com
ADMIN_AUTH_URL=https://moderato-art.test
ADMIN_AUTH_RESEND_FROM=Moderato Art <admin@moderato-art.test>
ADMIN_AUTH_RESEND_KEY=re_replace-with-a-dedicated-restricted-key
ADMIN_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
